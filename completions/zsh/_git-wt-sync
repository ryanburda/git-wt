#compdef git-wt-sync
#
# zsh completion for `git wt-sync` and for the standalone
# `git-wt-sync` command.
#
# zsh's _git dispatches an unknown sub-command to a function named
# `_git-<sub-command>`, so this file has to keep the name `_git-wt-sync`
# and sit on your fpath.

__git_wt_sync_worktree_names() {
  local -a names
  # Only parked worktrees: a detached HEAD is what `git wt-sync` acts on, and
  # one with a branch checked out is reported and left alone. The bare repo is
  # skipped -- it has no working tree to update. `git wt-sync` takes a name,
  # not a path, so report the last path segment.
  names=(${(f)"$(git worktree list --porcelain 2>/dev/null | awk '
    /^worktree /{wt = substr($0, 10); detached = 0; bare = 0}
    /^bare$/{bare = 1}
    /^detached$/{detached = 1}
    /^$/{if (wt != "" && !bare && detached) print wt; wt = ""}
    END{if (wt != "" && !bare && detached) print wt}
  ' | sed 's|.*/||')"})
  _describe -t worktrees 'parked worktree' names
}

__git_wt_sync_commit_ish() {
  local -a refs
  # Anywhere -b can re-park a worktree: local branches, remote branches with
  # the remote name stripped, and tags.
  refs=(
    ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/tags 2>/dev/null)"}
    ${(f)"$(git for-each-ref --format='%(refname:strip=3)' refs/remotes 2>/dev/null)"}
  )
  refs=(${(u)refs:#(HEAD|)})
  _describe -t commits commit-ish refs
}

_git-wt-sync() {
  _arguments -S \
    '-n[no fetch: sync against the refs already here]' \
    '-f[sync a worktree that has modified or untracked files, discarding them]' \
    '-b[re-park the named worktree here instead of at the default branch]:commit-ish:__git_wt_sync_commit_ish' \
    '-h[print help and exit]' \
    '1::worktree name:__git_wt_sync_worktree_names'
}

_git-wt-sync "$@"
