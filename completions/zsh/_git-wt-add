#compdef git-wt-add
#
# zsh completion for `git wt-add` and for the standalone
# `git-wt-add` command.
#
# zsh's _git dispatches an unknown sub-command to a function named
# `_git-<sub-command>`, so this file has to keep the name `_git-wt-add`
# and sit on your fpath.

__git_wt_add_branches() {
  local -a branches
  # Local branches, plus remote branches with the remote name stripped:
  # `git worktree add` and `git switch` both resolve a bare `topic` to
  # `origin/topic` themselves.
  branches=(
    ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"}
    ${(f)"$(git for-each-ref --format='%(refname:strip=3)' refs/remotes 2>/dev/null)"}
  )
  branches=(${(u)branches:#(HEAD|)})
  _describe -t branches branch branches
}

_git-wt-add() {
  # <worktree_name> must not exist yet, so there is nothing to complete for it;
  # the same goes for <new_branch>, a name being invented.
  _arguments -S \
    '-h[print help and exit]' \
    '1:worktree name:' \
    '2:branch:__git_wt_add_branches' \
    '3:new branch:'
}

_git-wt-add "$@"
