#compdef git-worktree-setup
#
# zsh completion for `git worktree-setup` and for the standalone
# `git-worktree-setup` command.
#
# zsh's _git dispatches an unknown sub-command to a function named
# `_git-<sub-command>`, so this file has to keep the name
# `_git-worktree-setup` and sit on your fpath.

__git_ext_worktrees() {
  local -a worktrees
  # Every worktree of the current repo except the bare one, which has no
  # checkout to run a setup hook in.
  worktrees=(${(f)"$(git worktree list --porcelain 2>/dev/null | awk '
    /^worktree /{wt = substr($0, 10); bare = 0}
    /^bare$/{bare = 1}
    /^$/{if (wt != "" && !bare) print wt; wt = ""}
    END{if (wt != "" && !bare) print wt}
  ')"})
  _describe -t worktrees worktree worktrees
}

_git-worktree-setup() {
  # The single argument is optional: with none, the current worktree is used.
  _arguments -S '1:worktree path:__git_ext_worktrees'
}

_git-worktree-setup "$@"
