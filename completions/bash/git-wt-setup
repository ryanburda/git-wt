# bash completion for `git wt-setup` and for the standalone
# `git-wt-setup` command.
#
# git's own completion dispatches `git <sub-command>` to a function named
# `_git_<sub_command>`, and asks bash-completion's lazy loader for a file named
# `git-<sub-command>` when that function isn't defined yet. Naming this file
# `git-wt-setup` and defining `_git_wt_setup` satisfies both.

__git_ext_worktrees ()
{
	# Prefer git's own wrapper, which honors `git -C <dir>` and `--git-dir`.
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# Every worktree of the current repo except the bare one, which has no
	# checkout to run a setup hook in.
	$g worktree list --porcelain 2> /dev/null | awk '
		/^worktree /{wt = substr($0, 10); bare = 0}
		/^bare$/{bare = 1}
		/^$/{if (wt != "" && !bare) print wt; wt = ""}
		END{if (wt != "" && !bare) print wt}
	'
}

_git_wt_setup ()
{
	local cur=${COMP_WORDS[COMP_CWORD]}
	local i idx=0

	# Find the sub-command so argument positions come out the same whether we
	# were reached as `git wt-setup` or as `git-wt-setup`.
	for ((i = 0; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
		wt-setup | git-wt-setup | */git-wt-setup)
			idx=$i
			break
			;;
		esac
	done

	# [<worktree_path>] — only the one optional argument.
	if ((COMP_CWORD - idx == 1)); then
		COMPREPLY=($(compgen -W "$(__git_ext_worktrees)" -- "$cur"))
	else
		COMPREPLY=()
	fi
}

# The `git wt-setup` form is dispatched by git's completion; this covers
# running the command directly.
complete -F _git_wt_setup git-wt-setup
