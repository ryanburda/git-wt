# bash completion for `git bud` and for the standalone
# `git-bud` command.
#
# git's own completion dispatches `git <sub-command>` to a function named
# `_git_<sub_command>`, and asks bash-completion's lazy loader for a file named
# `git-<sub-command>` when that function isn't defined yet. Naming this file
# `git-bud` and defining `_git_bud` satisfies both.

__git_wt_bud_branches ()
{
	# Prefer git's own wrapper, which honors `git -C <dir>` and `--git-dir`.
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# Local branches, plus remote branches with the remote name stripped:
	# `git worktree add` and `git switch` both resolve a bare `topic` to
	# `origin/topic` themselves.
	{
		$g for-each-ref --format='%(refname:short)' refs/heads
		$g for-each-ref --format='%(refname:strip=3)' refs/remotes
	} 2> /dev/null | grep -vx HEAD | sort -u
}

__git_wt_bud_worktree_names ()
{
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# <worktree_name> may name a worktree that does not exist yet, so this is a
	# suggestion rather than the full set of valid answers: the worktrees that
	# are already there, which `git bud` checks out into in place. The bare
	# repo is skipped. A name, not a path, so report the last path segment.
	$g worktree list --porcelain 2> /dev/null | awk '
		/^worktree /{wt = substr($0, 10); bare = 0}
		/^bare$/{bare = 1}
		/^$/{if (wt != "" && !bare) print wt; wt = ""}
		END{if (wt != "" && !bare) print wt}
	' | sed 's|.*/||'
}

_git_bud ()
{
	local cur=${COMP_WORDS[COMP_CWORD]}
	local i idx=0 args=0

	# Find the sub-command so argument positions come out the same whether we
	# were reached as `git bud` or as `git-bud`.
	for ((i = 0; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
		bud | git-bud | */git-bud)
			idx=$i
			break
			;;
		esac
	done

	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W "-f -h" -- "$cur"))
		return
	fi

	# [-f] <worktree_name> <branch> [<new_branch>]: count only the non-option
	# words before the cursor, so the arguments complete whether or not -f was
	# given. <new_branch> is a name being invented, so it is not completable.
	for ((i = idx + 1; i < COMP_CWORD; i++)); do
		[[ ${COMP_WORDS[i]} == -* ]] || ((args++))
	done

	case $args in
	0) COMPREPLY=($(compgen -W "$(__git_wt_bud_worktree_names)" -- "$cur")) ;;
	1) COMPREPLY=($(compgen -W "$(__git_wt_bud_branches)" -- "$cur")) ;;
	*) COMPREPLY=() ;;
	esac
}

# The `git bud` form is dispatched by git's completion; this covers
# running the command directly.
complete -F _git_bud git-bud
