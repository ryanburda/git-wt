# bash completion for `git wt-rm` and for the standalone
# `git-wt-rm` command.
#
# git's own completion dispatches `git <sub-command>` to a function named
# `_git_<sub_command>`, and asks bash-completion's lazy loader for a file named
# `git-<sub-command>` when that function isn't defined yet. Naming this file
# `git-wt-rm` and defining `_git_wt_rm` satisfies both.

__git_ext_worktree_names ()
{
	# Prefer git's own wrapper, which honors `git -C <dir>` and `--git-dir`.
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# `git wt-rm` takes a name, not a path, so report the last path
	# segment. The bare repo is skipped: it isn't a worktree to remove.
	$g worktree list --porcelain 2> /dev/null | awk '
		/^worktree /{wt = substr($0, 10); bare = 0}
		/^bare$/{bare = 1}
		/^$/{if (wt != "" && !bare) print wt; wt = ""}
		END{if (wt != "" && !bare) print wt}
	' | sed 's|.*/||'
}

_git_wt_rm ()
{
	local cur=${COMP_WORDS[COMP_CWORD]}
	local i idx=0 args=0

	# Find the sub-command so argument positions come out the same whether we
	# were reached as `git wt-rm` or as `git-wt-rm`.
	for ((i = 0; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
		wt-rm | git-wt-rm | */git-wt-rm)
			idx=$i
			break
			;;
		esac
	done

	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W "-f -h" -- "$cur"))
		return
	fi

	# [-f] <worktree_name> — count only the non-option words before the cursor,
	# so the name completes whether or not -f was given.
	for ((i = idx + 1; i < COMP_CWORD; i++)); do
		[[ ${COMP_WORDS[i]} == -* ]] || ((args++))
	done

	if ((args == 0)); then
		COMPREPLY=($(compgen -W "$(__git_ext_worktree_names)" -- "$cur"))
	else
		COMPREPLY=()
	fi
}

# The `git wt-rm` form is dispatched by git's completion; this covers
# running the command directly.
complete -F _git_wt_rm git-wt-rm
