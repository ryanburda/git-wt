# bash completion for `git clip` and for the standalone
# `git-clip` command.
#
# git's own completion dispatches `git <sub-command>` to a function named
# `_git_<sub_command>`, and asks bash-completion's lazy loader for a file named
# `git-<sub-command>` when that function isn't defined yet. Naming this file
# `git-clip` and defining `_git_clip` satisfies both.

__git_wt_worktree_names ()
{
	# Prefer git's own wrapper, which honors `git -C <dir>` and `--git-dir`.
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# With $1 set to "branch", only worktrees that have a branch checked out:
	# under -k there is nothing to clip off one that already has a detached
	# HEAD. Otherwise every worktree, since any of them can be removed. The bare
	# repo is skipped: it isn't a worktree to clip. `git clip` takes a name,
	# not a path, so report the last path segment.
	$g worktree list --porcelain 2> /dev/null | awk -v need_branch="${1:-}" '
		/^worktree /{wt = substr($0, 10); branch = 0; bare = 0}
		/^bare$/{bare = 1}
		/^branch /{branch = 1}
		/^$/{if (wt != "" && !bare && (need_branch == "" || branch)) print wt; wt = ""}
		END{if (wt != "" && !bare && (need_branch == "" || branch)) print wt}
	' | sed 's|.*/||'
}

__git_wt_clip_commit_ish ()
{
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# Anywhere -b can park a detached HEAD: local branches, remote branches
	# with the remote name stripped, and tags.
	{
		$g for-each-ref --format='%(refname:short)' refs/heads refs/tags
		$g for-each-ref --format='%(refname:strip=3)' refs/remotes
	} 2> /dev/null | grep -vx HEAD | sort -u
}

_git_clip ()
{
	local cur=${COMP_WORDS[COMP_CWORD]}
	local prev=${COMP_WORDS[COMP_CWORD - 1]}
	local i idx=0 args=0 keep=

	# Find the sub-command so argument positions come out the same whether we
	# were reached as `git clip` or as `git-clip`.
	for ((i = 0; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
		clip | git-clip | */git-clip)
			idx=$i
			break
			;;
		esac
	done

	# -b takes an argument, so the word after it is a commit-ish, not the name.
	if [[ $prev == -b ]]; then
		COMPREPLY=($(compgen -W "$(__git_wt_clip_commit_ish)" -- "$cur"))
		return
	fi

	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W "-k -f -b -h" -- "$cur"))
		return
	fi

	# [-k] [-f] [-b <commit-ish>] <worktree_name>: count only the non-option
	# words before the cursor, skipping -b's argument, so the name completes
	# whatever flags came first. -k narrows which worktrees are worth offering.
	for ((i = idx + 1; i < COMP_CWORD; i++)); do
		if [[ ${COMP_WORDS[i]} == -b ]]; then
			((i++))
			continue
		fi
		case ${COMP_WORDS[i]} in
		-*k* | -k) keep=branch ;;
		esac
		[[ ${COMP_WORDS[i]} == -* ]] || ((args++))
	done

	if ((args == 0)); then
		COMPREPLY=($(compgen -W "$(__git_wt_worktree_names "$keep")" -- "$cur"))
	else
		COMPREPLY=()
	fi
}

# The `git clip` form is dispatched by git's completion; this covers
# running the command directly.
complete -F _git_clip git-clip
