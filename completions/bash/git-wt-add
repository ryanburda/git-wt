# bash completion for `git wt-add` and for the standalone
# `git-wt-add` command.
#
# git's own completion dispatches `git <sub-command>` to a function named
# `_git_<sub_command>`, and asks bash-completion's lazy loader for a file named
# `git-<sub-command>` when that function isn't defined yet. Naming this file
# `git-wt-add` and defining `_git_wt_add` satisfies both.

__git_wt_add_branches ()
{
	# Prefer git's own wrapper, which honors `git -C <dir>` and `--git-dir`.
	local g=git
	declare -f __git > /dev/null 2>&1 && g=__git

	# Local branches, plus remote branches with the remote name stripped:
	# `git worktree add` and `git switch` both resolve a bare `topic` to
	# `origin/topic` themselves.
	{
		$g for-each-ref --format='%(refname:short)' refs/heads
		$g for-each-ref --format='%(refname:strip=3)' refs/remotes
	} 2> /dev/null | grep -vx HEAD | sort -u
}

_git_wt_add ()
{
	local cur=${COMP_WORDS[COMP_CWORD]}
	local i idx=0 args=0

	# Find the sub-command so argument positions come out the same whether we
	# were reached as `git wt-add` or as `git-wt-add`.
	for ((i = 0; i < COMP_CWORD; i++)); do
		case ${COMP_WORDS[i]} in
		wt-add | git-wt-add | */git-wt-add)
			idx=$i
			break
			;;
		esac
	done

	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W "-h" -- "$cur"))
		return
	fi

	# <worktree_name> <branch> [<new_branch>]: count only the non-option words
	# before the cursor. <worktree_name> must not exist yet and <new_branch> is a
	# name being invented, so neither is completable -- only <branch> is.
	for ((i = idx + 1; i < COMP_CWORD; i++)); do
		[[ ${COMP_WORDS[i]} == -* ]] || ((args++))
	done

	case $args in
	1) COMPREPLY=($(compgen -W "$(__git_wt_add_branches)" -- "$cur")) ;;
	*) COMPREPLY=() ;;
	esac
}

# The `git wt-add` form is dispatched by git's completion; this covers
# running the command directly.
complete -F _git_wt_add git-wt-add
