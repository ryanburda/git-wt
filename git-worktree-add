#!/bin/zsh
set -e

usage() {
    cat >&2 <<'EOF'
Usage:
  git worktree-add <worktree_name> <branch> [<new_branch>]

Works with `git clone-bare` to enforce a repo
folder structure that accommodates worktrees:

  $root_path/
  ├── .git/              <- bare repo (created by clone-bare or seed)
  ├── feature-a/         <- worktree (created by worktree-add)
  └── feature-b/         <- worktree (created by worktree-add)

The worktree is created as a sibling of the .git bare repo directory,
regardless of where the command is run from within the repo.

Arguments:
  -h               Print this help and exit.
  <worktree_name>  A directory name, not a path. It is always joined onto the
                   project root derived from the bare repo's location, never
                   the current directory, so the same command from a nested
                   subdirectory or another worktree lands in the same place.
                   Names containing "/", and "." and "..", are rejected: every
                   worktree is a direct child of the project root, which is what
                   keeps git's internal worktree names unambiguous.
  <branch>         With two arguments, the existing branch (or any commit-ish)
                   to check out. With three, the start point for <new_branch>.
  <new_branch>     Optional. When given, a branch by this name is created off
                   <branch> and checked out in the new worktree.

Returns:
  Prints the absolute path of the worktree on stdout. Adding a worktree that
  already exists is a no-op that still prints the path and exits 0, so this is
  safe to re-run.

Examples:
  git worktree-add wt1 main          # checkout main in $root_path/wt1
  git worktree-add wt1 main feature  # create branch "feature" off main in $root_path/wt1
EOF
}

if [[ "$1" == "-h" ]]; then
    usage
    exit 0
fi

if [[ $# -lt 2 || $# -gt 3 ]]; then
    usage
    exit 129
fi

WORKTREE_NAME=$1
BRANCH=$2
NEW_BRANCH=$3

# <worktree_name> is joined onto the project root, so it has to be a single path
# segment. A name containing "/" would nest the worktree, and git names a worktree
# after the last segment of its path -- two nested worktrees ending in the same
# segment collide and git silently disambiguates them as "wt", "wt1", leaving the
# short name ambiguous. ".." would place the worktree outside the project entirely.
case "$WORKTREE_NAME" in
    */*)
        echo "Error: <worktree_name> must be a directory name, not a path: '${WORKTREE_NAME}'" >&2
        exit 128
        ;;
    ""|"."|"..")
        echo "Error: invalid <worktree_name>: '${WORKTREE_NAME}'" >&2
        exit 128
        ;;
esac

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: not inside a git repository" >&2
    exit 128
fi

BARE_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
PROJECT_ROOT="${BARE_DIR%/.git}"
WORKTREE_PATH="${PROJECT_ROOT}/${WORKTREE_NAME}"

# Re-adding an existing worktree is the normal case for a setup script that runs
# on every bootstrap, not an error: report it on stderr, print the path, and exit
# 0 exactly as a fresh add would. A path that exists but isn't a worktree of this
# repo is a genuine name collision, and still fails.
if [[ -d "$WORKTREE_PATH" ]]; then
    if git worktree list --porcelain | grep -qFx "worktree ${WORKTREE_PATH}"; then
        echo "Worktree already exists at ${WORKTREE_PATH}, skipping add." >&2
        echo "$WORKTREE_PATH"
        exit 0
    fi
    echo "Error: ${WORKTREE_PATH} already exists and is not a worktree of this repo" >&2
    exit 128
fi

if [[ -n "$NEW_BRANCH" ]]; then
    git worktree add -b "$NEW_BRANCH" "$WORKTREE_PATH" "$BRANCH" >&2
else
    git worktree add "$WORKTREE_PATH" "$BRANCH" >&2
fi

# Set upstream tracking branch if not already set.
WT_BRANCH=$(git -C "$WORKTREE_PATH" branch --show-current)
if [[ -n "$WT_BRANCH" ]] && ! git -C "$WORKTREE_PATH" config "branch.${WT_BRANCH}.remote" > /dev/null 2>&1; then
    REMOTE_REF="refs/remotes/origin/${WT_BRANCH}"
    if git -C "$WORKTREE_PATH" show-ref --verify --quiet "$REMOTE_REF"; then
        git -C "$WORKTREE_PATH" branch --set-upstream-to="origin/${WT_BRANCH}" >&2
    fi
fi

echo "$WORKTREE_PATH"
