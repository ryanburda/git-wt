#!/bin/zsh
set -e

usage() {
    cat >&2 <<'EOF'
Usage:
  git wt-park [-n] [-f] [<worktree_name>]                 # park it at mainline
  git wt-park [-n] [-f] -b <commit-ish> [<worktree_name>] # park somewhere else

Leaves a worktree in a detached HEAD state, releasing the branch it was on.

The worktree is not removed. A branch can only be checked out in one worktree
at a time, so a worktree sitting idle on a branch holds that branch hostage.
Removing the worktree frees the branch, but it also throws away anything that
was setup using `git wt-setup`. So it detaches HEAD instead: the branch is free
to check out elsewhere or delete, while the directory and everything in it stays put.

  git wt-park wt1            # wt1 keeps its files; its branch is free
  git branch -d feature      # ...so this now works
  git -C wt1 switch other    # ...and wt1 is ready for another branch

Arguments:
  -n               No fetch. Park against the refs already in the repo.
  -f               Force. Parks a worktree that has modified or untracked files,
                   discarding them.
  -b <commit-ish>  Where to leave the detached HEAD, instead of the latest
                   commit on the default branch.
  -h               Print this help and exit.
  <worktree_name>  Optional. A worktree name. Uses the current worktree if not provided.

Returns:
  Prints the branch the worktree was on before parking so it
  can be handed straight to whatever comes next:

    git branch -d "$(git wt-park wt1)"

  Prints nothing if already parked.

Examples:
  git wt-park              # park the worktree you're standing in
  git wt-park wt1          # park $root_path/wt1
  git wt-park -n wt1       # no fetch; something else already did one
  git wt-park -f wt1       # discard wt1's leftover files and park it
  git wt-park -b v2.1 wt1  # park wt1 on the v2.1 tag instead
EOF
}

NO_FETCH=0
FORCE=0
DETACH_AT=""

while getopts ":nfb:h" opt; do
    case $opt in
        n) NO_FETCH=1 ;;
        f) FORCE=1 ;;
        b) DETACH_AT=$OPTARG ;;
        h) usage; exit 0 ;;
        :) echo "Error: -$OPTARG requires an argument" >&2; usage; exit 129 ;;
        \?) echo "Error: unknown option -$OPTARG" >&2; usage; exit 129 ;;
    esac
done
shift $((OPTIND - 1))

if [[ $# -gt 1 ]]; then
    usage
    exit 129
fi

# Shell completion on a directory hands you "wt1/". That names the same
# worktree, so trim trailing slashes rather than rejecting them below.
WORKTREE_NAME=${1:-}
while [[ "$WORKTREE_NAME" == */ ]]; do WORKTREE_NAME=${WORKTREE_NAME%/}; done

# Validate WORKTREE_NAME
case "$WORKTREE_NAME" in
    */*)
        echo "Error: <worktree_name> must be a directory name, not a path: '${WORKTREE_NAME}'" >&2
        exit 128
        ;;
    "."|".."|".git")
        echo "Error: invalid <worktree_name>: '${WORKTREE_NAME}'" >&2
        exit 128
        ;;
esac

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: not inside a git repository" >&2
    exit 128
fi

BARE_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
PROJECT_ROOT="${BARE_DIR%/.git}"

if [[ -n "$WORKTREE_NAME" ]]; then
    WORKTREE_PATH="${PROJECT_ROOT}/${WORKTREE_NAME}"

    # The porcelain listing is the authority on what is a worktree of this repo.
    if ! git worktree list --porcelain | grep -qFx "worktree ${WORKTREE_PATH}"; then
        if [[ -e "$WORKTREE_PATH" ]]; then
            echo "Error: ${WORKTREE_PATH} exists and is not a worktree of this repo" >&2
        else
            echo "Error: no worktree at ${WORKTREE_PATH}" >&2
        fi
        exit 128
    fi

    # Unpruned worktree
    if [[ ! -d "$WORKTREE_PATH" ]]; then
        echo "Error: ${WORKTREE_PATH} is registered but its directory is missing" >&2
        echo "Run 'git worktree prune' to clear it, then 'git wt-add' to grow it back." >&2
        exit 128
    fi
elif ! WORKTREE_PATH=$(git rev-parse --show-toplevel 2>/dev/null); then
    # The project root itself is not a worktree -- it holds the bare repo, which
    # has no working tree -- so say so rather than letting git's own "must be run
    # in a work tree" out.
    echo "Error: not inside a worktree (the project root holds the bare repo)" >&2
    echo "Name the worktree to park: git wt-park <worktree_name>" >&2
    exit 128
fi

# Fetching is what makes "the latest commit on mainline" true, but it is the one
# step that can fail for reasons that have nothing to do with this repo: being
# offline should not stop a worktree from parking at the newest commit on disk.
if (( ! NO_FETCH )); then
    if ! git -C "$BARE_DIR" remote get-url origin > /dev/null 2>&1; then
        echo "No 'origin' remote; skipping fetch." >&2
    elif ! git -C "$BARE_DIR" fetch --prune origin >&2; then
        echo "Warning: fetch failed; parking against the refs already here." >&2
    fi
fi

if [[ -z "$DETACH_AT" ]]; then
    if ! DEFAULT_BRANCH=$(git -C "$BARE_DIR" symbolic-ref --short HEAD 2>/dev/null); then
        echo "Error: could not read the project's default branch from ${BARE_DIR}" >&2
        echo "Pass -b <commit-ish> to say where to leave the detached HEAD." >&2
        exit 128
    fi

    # Prefer the remote-tracking ref. The local branch is the fallback for a repo with no origin.
    if git show-ref --verify --quiet "refs/remotes/origin/${DEFAULT_BRANCH}"; then
        DETACH_AT="origin/${DEFAULT_BRANCH}"
    elif git show-ref --verify --quiet "refs/heads/${DEFAULT_BRANCH}"; then
        DETACH_AT=$DEFAULT_BRANCH
    else
        echo "Error: default branch '${DEFAULT_BRANCH}' has no origin or local ref" >&2
        echo "Pass -b <commit-ish> to say where to leave the detached HEAD." >&2
        exit 128
    fi
fi

if ! TARGET_SHA=$(git -C "$BARE_DIR" rev-parse --verify --quiet "${DETACH_AT}^{commit}"); then
    echo "Error: '${DETACH_AT}' is not a commit in this repository" >&2
    exit 128
fi
TARGET_SHORT=$(git -C "$BARE_DIR" rev-parse --short "$TARGET_SHA")
CURRENT_SHORT=$(git -C "$WORKTREE_PATH" rev-parse --short HEAD)

# Get the current branch so it can be returned later. Empty when already parked.
CURRENT_BRANCH=$(git -C "$WORKTREE_PATH" branch --show-current)

# Re-running after a fetch that brought nothing new is the normal case, not an
# error: report it and exit 0. There was no branch on it, so nothing to return.
if [[ -z "$CURRENT_BRANCH" && "$(git -C "$WORKTREE_PATH" rev-parse HEAD)" == "$TARGET_SHA" ]]; then
    echo "Worktree ${WORKTREE_PATH} is already parked at ${DETACH_AT} (${TARGET_SHORT}), skipping." >&2
    exit 0
fi

# Refuse a dirty worktree without -f
if [[ -n "$(git -C "$WORKTREE_PATH" status --porcelain)" ]]; then
    if (( ! FORCE )); then
        echo "Error: ${WORKTREE_PATH} has modified or untracked files" >&2
        echo "Commit or clean them, or use -f to discard them." >&2
        exit 128
    fi
    echo "Discarding modified and untracked files in ${WORKTREE_PATH}." >&2
    git -C "$WORKTREE_PATH" clean -fd >&2
fi

FORCE_ARG=()
(( FORCE )) && FORCE_ARG=(--force)

# The resolved SHA rather than the ref name, so what lands is what was reported even if origin moves underneath us.
git -C "$WORKTREE_PATH" -c advice.detachedHead=false \
    checkout --quiet "${FORCE_ARG[@]}" --detach "$TARGET_SHA" >&2

# Keeping the stdout write inside this branch is what keeps the exit status 0: a
# trailing `[[ -n ... ]] && echo` would fail the script when there was no branch.
if [[ -n "$CURRENT_BRANCH" ]]; then
    echo "Worktree ${WORKTREE_PATH} kept; branch '${CURRENT_BRANCH}' is free." >&2
    echo "  put it back: git -C ${WORKTREE_PATH} switch ${CURRENT_BRANCH}" >&2
    echo "$CURRENT_BRANCH"
else
    echo "Worktree ${WORKTREE_PATH} moved: ${CURRENT_SHORT} -> ${TARGET_SHORT} (${DETACH_AT})." >&2
fi
