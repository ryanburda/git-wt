#!/bin/zsh
set -e

usage() {
    cat >&2 <<'EOF'
Usage:
  git wt-clip [-n] [-f] [<worktree_name>]                 # clip off its branch
  git wt-clip [-n] [-f] -b <commit-ish> [<worktree_name>] # park somewhere else

The counterpart to `git wt-bud`. Clips the branch off a worktree in the repo
folder structure these commands enforce:

  $root_path/
  ├── .git/              <- bare repo (created by seed)
  ├── feature-a/         <- worktree (created by bud)
  └── feature-b/         <- worktree (clipped by clip)

The worktree is looked up as a sibling of the .git bare repo directory,
regardless of where the command is run from within the repo.

Nothing is removed. A branch can only be checked out in one worktree at a time,
so a worktree sitting idle on a branch holds that branch hostage -- you cannot
check it out elsewhere and you cannot delete it. Removing the worktree frees the
branch, but it also throws away any setup that was done for that worktree -- its
node_modules, its .venv, its .env -- every slow thing `git wt-setup` did, which
you then pay for again.

So clip detaches HEAD instead: the worktree keeps no branch checked out while
the directory and everything in it stays exactly where it is. The branch is then
free to check out elsewhere or delete, and `git wt-bud` buds one back on when
you want the worktree again.

  git wt-clip wt1          # wt1 keeps its files; its branch is free
  git branch -d feature    # ...so this now works
  git wt-bud wt1 main feature

`git worktree list` is how you see which worktrees are parked this way; they
show up as "(detached HEAD)".

Removing a worktree outright is `git worktree remove`, which already does that
job. In this layout every worktree is a direct child of the project root, so the
path it wants is never ambiguous.

Where it parks:
  origin/<default branch> -- the latest commit on mainline, fetched first unless
  -n says not to. In this layout the local default branch is usually stale: a
  plain fetch updates refs/remotes/origin/* and leaves refs/heads/main where it
  was, and nothing pulls the bare repo's own branches. The remote-tracking ref
  is the one a fetch keeps current, so it is the one worth parking on. The local
  branch is the fallback for a repo that has no origin.

  Which branch is the default is read from the bare repo's HEAD, the same source
  `git seed` uses, so main and master both work without being told which.

Re-running it is how a parked worktree moves forward. A detached HEAD is a
commit, not a ref, so it never advances on its own: fetching origin a hundred
times leaves a parked worktree exactly where it stood the day it was clipped.
Clipping it again fetches and moves it to mainline's new tip.

  git wt-clip wt1        # parks wt1 at mainline as it is today
  ...weeks of upstream commits...
  git wt-clip wt1        # wt1 is at mainline again

Arguments:
  -n               No fetch. Park against the refs already in the repo. Use it
                   when something else just fetched -- a lazygit binding that
                   runs its own fetch first, a loop over several worktrees --
                   so the network is paid for once rather than once per call.
  -f               Force. Clips a worktree that has modified or untracked files,
                   discarding them. Without it, either one is an error and
                   nothing is changed. A lock is irrelevant, since nothing is
                   being removed: the `base` worktree `git seed` locks parks
                   like any other.
  -b <commit-ish>  Where to leave the detached HEAD, instead of the latest
                   commit on the default branch. Naming a commit is saying you
                   mean it: a tag, an older commit, anything reachable.
  -h               Print this help and exit.
  <worktree_name>  Optional. A directory name, not a path. It is always joined
                   onto the project root derived from the bare repo's location,
                   never the current directory, so the same command from a
                   nested subdirectory or another worktree clips the same
                   worktree. Names containing "/", and "." and "..", are
                   rejected: only direct children of the project root are
                   worktrees this command knows how to clip. A trailing "/" is
                   ignored, so a name completed as a directory works.

                   Without it, the worktree containing the current directory,
                   which is what makes the bare `git wt-clip` useful from a
                   tool that already sits in one.

Returns:
  Prints the worktree's path, so the usual form works:

    cd "$(git wt-clip wt1)"

  The worktree survives, so a worktree that isn't there is an error rather than
  a no-op: there is nothing to clip. A worktree already parked at the commit it
  would be moved to is a no-op that prints the path and exits 0, so re-running
  this is safe.

  The branch that was clipped off is reported on stderr with its short SHA,
  which is what you need if you delete the branch and later want it back.

Examples:
  git wt-clip              # clip the worktree you're standing in
  git wt-clip wt1          # clip $root_path/wt1
  git wt-clip -n wt1       # no fetch; something else already did one
  git wt-clip -f wt1       # discard wt1's leftover files and clip it
  git wt-clip -b v2.1 wt1  # park wt1 on the v2.1 tag instead
EOF
}

NO_FETCH=0
FORCE=0
DETACH_AT=""

while getopts ":nfb:h" opt; do
    case $opt in
        n) NO_FETCH=1 ;;
        f) FORCE=1 ;;
        b) DETACH_AT=$OPTARG ;;
        h) usage; exit 0 ;;
        :) echo "Error: -$OPTARG requires an argument" >&2; usage; exit 129 ;;
        \?) echo "Error: unknown option -$OPTARG" >&2; usage; exit 129 ;;
    esac
done
shift $((OPTIND - 1))

if [[ $# -gt 1 ]]; then
    usage
    exit 129
fi

WORKTREE_NAME=${1:-}

if [[ -n "$WORKTREE_NAME" ]]; then
    # Shell completion on a directory hands you "wt1/". That names the same
    # worktree, so trim trailing slashes rather than rejecting them below.
    while [[ "$WORKTREE_NAME" == */ ]]; do
        WORKTREE_NAME=${WORKTREE_NAME%/}
    done

    # <worktree_name> is joined onto the project root, so it has to be a single
    # path segment, for the same reason `git wt-bud` requires one: every worktree
    # in this layout is a direct child of the project root. Anything else names a
    # path this command didn't create and won't touch. ".git" is the bare repo
    # itself, which has no working tree to clip.
    case "$WORKTREE_NAME" in
        */*)
            echo "Error: <worktree_name> must be a directory name, not a path: '${WORKTREE_NAME}'" >&2
            exit 128
            ;;
        "."|".."|".git")
            echo "Error: invalid <worktree_name>: '${WORKTREE_NAME}'" >&2
            exit 128
            ;;
    esac
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: not inside a git repository" >&2
    exit 128
fi

BARE_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
PROJECT_ROOT="${BARE_DIR%/.git}"

if [[ -n "$WORKTREE_NAME" ]]; then
    WORKTREE_PATH="${PROJECT_ROOT}/${WORKTREE_NAME}"

    # The porcelain listing is the authority on what is a worktree of this repo.
    # A directory sitting at that name proves nothing either way.
    if ! git worktree list --porcelain | grep -qFx "worktree ${WORKTREE_PATH}"; then
        if [[ -e "$WORKTREE_PATH" ]]; then
            echo "Error: ${WORKTREE_PATH} exists and is not a worktree of this repo" >&2
        else
            echo "Error: no worktree at ${WORKTREE_PATH}" >&2
        fi
        exit 128
    fi

    # Registered but not on disk. git keeps the metadata under .git/worktrees/
    # until something prunes it, so the listing above still reports it, while
    # every git command aimed at it fails. Stop here rather than letting a
    # `fatal: cannot change to ...` out.
    if [[ ! -d "$WORKTREE_PATH" ]]; then
        echo "Error: ${WORKTREE_PATH} is registered but its directory is missing" >&2
        echo "Run 'git worktree prune' to clear it, or 'git wt-bud' to grow it back." >&2
        exit 128
    fi
else
    # No name: the worktree the caller is standing in, the same default
    # `git wt-setup` uses. The project root itself is not one -- it holds the
    # bare repo, which has no working tree -- so say so rather than letting
    # git's own "must be run in a work tree" out.
    if ! WORKTREE_PATH=$(git rev-parse --show-toplevel 2>/dev/null); then
        echo "Error: not inside a worktree (the project root holds the bare repo)" >&2
        echo "Name the worktree to clip: git wt-clip <worktree_name>" >&2
        exit 128
    fi
    WORKTREE_NAME=${WORKTREE_PATH##*/}
fi

# Fetching is what makes "the latest commit on mainline" true -- parking against
# refs nobody refreshed is a slower way of standing still -- but it is the one
# step that can fail for reasons that have nothing to do with this repo. Being
# offline should not stop a worktree from parking at the newest commit on disk.
# It runs under -b too: a commit named as "origin/<something>" is only as current
# as the last fetch.
if (( ! NO_FETCH )); then
    if ! git -C "$BARE_DIR" remote get-url origin > /dev/null 2>&1; then
        echo "No 'origin' remote; skipping fetch." >&2
    elif ! git -C "$BARE_DIR" fetch --prune origin >&2; then
        echo "Warning: fetch failed; parking against the refs already here." >&2
    fi
fi

if [[ -z "$DETACH_AT" ]]; then
    # HEAD is per-worktree, so this has to be read from the common dir: the
    # current worktree's HEAD names the branch being clipped off, or is already
    # detached, and neither one is the project default.
    DEFAULT_BRANCH=$(git -C "$BARE_DIR" symbolic-ref --short HEAD 2>/dev/null || true)

    if [[ -z "$DEFAULT_BRANCH" ]]; then
        echo "Error: could not read the project's default branch from ${BARE_DIR}" >&2
        echo "Pass -b <commit-ish> to say where to leave the detached HEAD." >&2
        exit 128
    fi

    # Prefer the remote-tracking ref: a fetch moves refs/remotes/origin/* and
    # nothing else, so refs/heads/main is the stale copy here. The local branch
    # is the fallback for a repo with no origin, and covers a default branch that
    # exists upstream but was never checked out locally, which is the normal
    # state for every branch `git seed` didn't check out.
    if git show-ref --verify --quiet "refs/remotes/origin/${DEFAULT_BRANCH}"; then
        DETACH_AT="origin/${DEFAULT_BRANCH}"
    elif git show-ref --verify --quiet "refs/heads/${DEFAULT_BRANCH}"; then
        DETACH_AT=$DEFAULT_BRANCH
    else
        echo "Error: default branch '${DEFAULT_BRANCH}' has no origin or local ref" >&2
        echo "Pass -b <commit-ish> to say where to leave the detached HEAD." >&2
        exit 128
    fi
fi

if ! TARGET_SHA=$(git -C "$BARE_DIR" rev-parse --verify --quiet "${DETACH_AT}^{commit}"); then
    echo "Error: '${DETACH_AT}' is not a commit in this repository" >&2
    exit 128
fi
TARGET_SHORT=$(git -C "$BARE_DIR" rev-parse --short "$TARGET_SHA")

CURRENT_SHA=$(git -C "$WORKTREE_PATH" rev-parse HEAD)
CURRENT_SHORT=$(git -C "$WORKTREE_PATH" rev-parse --short HEAD)

# The branch tip, captured before detaching: reported below so that deleting the
# branch afterwards is still a recoverable act. Empty when the worktree is
# already parked.
CURRENT_BRANCH=$(git -C "$WORKTREE_PATH" branch --show-current)

# Already parked at the target. Re-running after a fetch that brought nothing
# new is the normal case, not an error: report it, print the path, and exit 0.
# A worktree still on a branch has a branch to clip off even when that branch
# happens to point at the target, so it is not this case.
if [[ -z "$CURRENT_BRANCH" && "$CURRENT_SHA" == "$TARGET_SHA" ]]; then
    echo "Worktree ${WORKTREE_PATH} is already parked at ${DETACH_AT} (${TARGET_SHORT}), skipping." >&2
    echo "$WORKTREE_PATH"
    exit 0
fi

# Refuse a dirty worktree without -f, the same as `git wt-bud`. Parking a
# worktree is meant to be reversible, and moving it onto another commit is not
# the moment to discover uncommitted work. `status --porcelain` counts staged,
# modified, and untracked-but-not-ignored files, so the files a setup hook drops
# in stay out of it as long as they are excluded -- see design_decisions.md on
# .git/info/exclude.
if [[ -n "$(git -C "$WORKTREE_PATH" status --porcelain)" ]]; then
    if (( ! FORCE )); then
        echo "Error: ${WORKTREE_PATH} has modified or untracked files" >&2
        echo "Commit or clean them, or use -f to discard them." >&2
        exit 128
    fi
    echo "Discarding modified and untracked files in ${WORKTREE_PATH}." >&2
    # Untracked files first: --force covers local modifications, and clearing
    # the untracked ones beforehand keeps the checkout from tripping over a
    # file the target commit also wants to write.
    git -C "$WORKTREE_PATH" clean -fd >&2
fi

CHECKOUT_ARGS=(--detach)
(( FORCE )) && CHECKOUT_ARGS=(--force --detach)

# The resolved SHA rather than the ref name, so what lands is what was reported
# even if origin moves underneath us. The advice is off because a detached HEAD
# is the expected state here, not something to warn about.
git -C "$WORKTREE_PATH" -c advice.detachedHead=false \
    checkout --quiet "${CHECKOUT_ARGS[@]}" "$TARGET_SHA" >&2

if [[ -n "$CURRENT_BRANCH" ]]; then
    echo "Worktree ${WORKTREE_PATH} kept; branch '${CURRENT_BRANCH}' (${CURRENT_SHORT}) is free." >&2
    echo "  delete it:   git branch -d ${CURRENT_BRANCH}" >&2
    echo "  put it back: git wt-bud ${WORKTREE_NAME} ${CURRENT_BRANCH}" >&2
else
    echo "Worktree ${WORKTREE_PATH} moved: ${CURRENT_SHORT} -> ${TARGET_SHORT} (${DETACH_AT})." >&2
fi

echo "$WORKTREE_PATH"
