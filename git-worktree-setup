#!/bin/zsh
set -e

usage() {
    cat >&2 <<'EOF'
Usage:
  git worktree-setup [<worktree_path>]

Run the project's worktree setup hook against a worktree.

The hook lives at <project_root>/.worktree/setup, next to the bare .git
directory.

This is deliberately separate from `git worktree-add`: setup can be slow, so
adding a worktree and preparing it are two different jobs.

Does nothing (successfully) when the project has no hook, so it is safe to
call unconditionally.

Arguments:
  -h               Print this help and exit.
  <worktree_path>  Optional. The directory the hook runs in. Defaults to the
                   worktree containing the current directory. The hook itself
                   is always looked up from the project root of the repo the
                   command is run in, not from this path.

Examples:
  cd ~/code/project_a/base && git worktree-setup
  git -C ~/code/project_a/base worktree-setup
EOF
}

if [[ "$1" == "-h" ]]; then
    usage
    exit 0
fi

if [[ $# -gt 1 ]]; then
    usage
    exit 129
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: not inside a git repository" >&2
    exit 128
fi

BARE_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
PROJECT_ROOT="${BARE_DIR%/.git}"

if [[ -n "$1" ]]; then
    [[ -d "$1" ]] || { echo "Error: $1 is not a directory" >&2; exit 128; }
    WORKTREE_PATH=$(cd "$1" && pwd)
else
    WORKTREE_PATH=$(git rev-parse --show-toplevel)
fi

SETUP_SCRIPT="${PROJECT_ROOT}/.worktree/setup"

if [[ ! -e "$SETUP_SCRIPT" ]]; then
    echo "No setup hook at ${SETUP_SCRIPT}; nothing to do." >&2
    exit 0
fi

if [[ ! -x "$SETUP_SCRIPT" ]]; then
    echo "Error: ${SETUP_SCRIPT} exists but is not executable" >&2
    exit 128
fi

(cd "$WORKTREE_PATH" && exec "$SETUP_SCRIPT")
