#!/bin/zsh
set -e

usage() {
    cat >&2 <<'EOF'
Usage:
  git seed [-b <branch>] [-w <worktree_name>] [-u] <repo_url> [<root_path>]

The worktree-first version of `git clone`: clones a repo
and creates its first worktree, in one step.

  $<root_path>/
  ├── .git/        <- bare repo
  └── base/        <- worktree, checked out on the default branch

Arguments:
  -b <branch>   Branch to check out in the worktree. Defaults to whatever the
                remote's HEAD points at, so main and master both just work.
  -w <name>     Worktree directory name, created under <root_path>.
                Default: base.
  -u            Leave the worktree unlocked. Locked is the default.
  -h            Print this help and exit.
  <repo_url>    Any URL `git clone` accepts; passed straight through to
                `git clone --bare`.
  <root_path>   Optional. The project root that ends up holding .git and the
                worktree beside it. Defaults to the project name derived from
                <repo_url> under the current directory, matching `git clone`.

Example:
  WT=$(git seed git@github.com:user/project_a.git ~/code/project_a)
EOF
}

BRANCH=""
# Why "base" as the default worktree name? Easiest to explain by the
# alternatives that didn't quite work:
#   - main/master shadows default branch naming conventions
#   - root (of a tree) evokes the idea of a superuser
#   - trunk carries its own meaning from older version control systems
# "base" is short, claimed by nothing else, and says what it is -- the
# base worktree that all other worktrees get added alongside.
WORKTREE_NAME="base"
LOCK=1

while getopts ":b:w:uh" opt; do
    case $opt in
        b) BRANCH=$OPTARG ;;
        w) WORKTREE_NAME=$OPTARG ;;
        u) LOCK=0 ;;
        h) usage; exit 0 ;;
        :) echo "Error: -$OPTARG requires an argument" >&2; usage; exit 129 ;;
        \?) echo "Error: unknown option -$OPTARG" >&2; usage; exit 129 ;;
    esac
done
shift $((OPTIND - 1))

if [[ $# -lt 1 || $# -gt 2 ]]; then
    usage
    exit 129
fi

REPO_URL=$1

if [[ -n "$2" ]]; then
    ROOT_PATH=$2
else
    # Derive project name from URL, matching git clone behavior:
    # strip the .git suffix and take the basename.
    ROOT_PATH="$(pwd)/$(basename "${REPO_URL}" .git)"
fi

BARE_DIR="${ROOT_PATH}/.git"

if [[ -d "$BARE_DIR" ]]; then
    echo "Bare repo already exists at ${BARE_DIR}, skipping clone." >&2
else
    mkdir -p "${ROOT_PATH}"
    # >&2 so only the worktree path reaches our stdout.
    git clone --bare "$REPO_URL" "$BARE_DIR" >&2
    # In a normal clone, git separates refs into:
    #   - refs/heads/* (local branches)
    #   - refs/remotes/origin/* (remote tracking branches)
    #
    # A bare repo was designed to be a server-side mirror - the central repo that
    # people push to and pull from. There's no local/remote distinction because every
    # branch *is* the authoritative copy. So `git clone --bare` maps everything
    # into refs/heads/* with fetch = +refs/heads/*:refs/heads/*.
    #
    # The worktree-based workflow repurposes bare repos for local development,
    # so we need the local/remote separation back. Fix the fetch refspec to
    # use the standard refs/remotes/origin/* namespace.
    git -C "$BARE_DIR" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'

    # bare clone creates local branches for every remote branch.
    # Remove all local branches except the default, then re-fetch into
    # refs/remotes/origin/* using the corrected refspec.
    DEFAULT_BRANCH=$(git -C "$BARE_DIR" symbolic-ref --short HEAD)
    git -C "$BARE_DIR" for-each-ref --format='%(refname)' refs/heads/ \
        | grep -v "^refs/heads/${DEFAULT_BRANCH}$" \
        | while read -r ref; do git -C "$BARE_DIR" update-ref -d "$ref"; done
    git -C "$BARE_DIR" fetch origin >&2
fi

if [[ -z "$BRANCH" ]]; then
    # The bare clone's HEAD points at the remote's default branch, so this
    # works whether the repo uses main, master, or something else entirely.
    BRANCH=$(git -C "$ROOT_PATH" symbolic-ref --short HEAD)
fi

WT=$(git -C "$ROOT_PATH" wt-add "$WORKTREE_NAME" "$BRANCH")

if (( LOCK )); then
    # Already locked is the normal state on a re-run; `worktree lock` exits 128
    # for it, which shouldn't fail the whole command.
    git -C "$ROOT_PATH" worktree lock "$WT" 2>/dev/null || true
fi

echo "$WT"
